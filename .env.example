# These will be automatically created by Neon Launchpad (https://neon.new).
# You will also need to 
DATABASE_URL=
DATABASE_URL_POOLER=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Google sign-in (Google Cloud console → APIs & Services → Credentials → OAuth client ID).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Polar (polar.sh) for the Support page. Leave empty to hide checkout.
# Webhook endpoint: <BETTER_AUTH_URL>/api/auth/polar/webhooks (event: order.paid, order.refunded)
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SUPPORT_PRODUCT_ID=

# Public site URL for canonical links, social cards, robots.txt and the sitemap
VITE_SITE_URL=http://localhost:3000
